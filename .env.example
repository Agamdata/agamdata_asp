# LLM
ANTHROPIC_API_KEY=sk-ant-[YOUR_KEY]

# Database
DATABASE_URL=postgresql+asyncpg://aspuser:yourpassword@localhost:5432/aiservice


# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCS=asp-documents

# App
ENVIRONMENT=local                  # local | staging | production
LOG_LEVEL=INFO
API_KEY_HEADER=X-ASP-API-Key       # header name modules must send

# Context store TTL
CONTEXT_TTL_SECONDS=3600           # 60 minutes

# Model routing (quality_tier -> model)
MODEL_STANDARD=claude-haiku-4-5-20251001
MODEL_ENHANCED=claude-sonnet-4-6
MODEL_PREMIUM=claude-opus-4-6

# Cost quota (USD per tenant per month, 0 = unlimited)
DEFAULT_MONTHLY_QUOTA_USD=50.0

# Webhook
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_SECONDS=30
